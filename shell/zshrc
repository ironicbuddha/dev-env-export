# macOS shell defaults for this repo's current workflow.

# Only set OPENAI_API_KEY locally if a specific workflow still needs it.
# export OPENAI_API_KEY="your-api-key-here"

# Homebrew
if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
elif [ -x "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# User bin locations
export PATH="$HOME/.local/bin:$PATH"

# Keep a preferred path entry at the front without accumulating duplicates.
path_prepend_distinct() {
    local entry="$1"

    if [ -z "$entry" ]; then
        return
    fi

    PATH=":$PATH:"
    PATH="${PATH//:$entry:/:}"
    PATH="${PATH#:}"
    PATH="${PATH%:}"

    if [ -n "$PATH" ]; then
        export PATH="$entry:$PATH"
    else
        export PATH="$entry"
    fi
}

# Python shims from Homebrew, if available
if command -v brew >/dev/null 2>&1; then
    PYTHON_PREFIX="$(brew --prefix python@3.13 2>/dev/null || true)"
    if [ -n "$PYTHON_PREFIX" ] && [ -d "$PYTHON_PREFIX/libexec/bin" ]; then
        path_prepend_distinct "$PYTHON_PREFIX/libexec/bin"
    fi
    unset PYTHON_PREFIX
fi

if [ -d "$HOME/Library/Python/3.13/bin" ]; then
    path_prepend_distinct "$HOME/Library/Python/3.13/bin"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
if [ -s "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# The oh-my-zsh git plugin aliases `gsd` to `git svn dcommit`.
# Drop that alias so the GSD v2 CLI binary wins in interactive shells.
unalias gsd 2>/dev/null || true

# nvm
export NVM_DIR="$HOME/.nvm"
if command -v brew >/dev/null 2>&1; then
    NVM_PREFIX="$(brew --prefix nvm 2>/dev/null || true)"
    if [ -n "$NVM_PREFIX" ] && [ -s "$NVM_PREFIX/nvm.sh" ]; then
        . "$NVM_PREFIX/nvm.sh"
    fi
    if [ -n "$NVM_PREFIX" ] && [ -s "$NVM_PREFIX/etc/bash_completion.d/nvm" ]; then
        . "$NVM_PREFIX/etc/bash_completion.d/nvm"
    fi
    unset NVM_PREFIX
fi

if command -v nvm >/dev/null 2>&1; then
    if [ "$(nvm version current 2>/dev/null)" = "system" ]; then
        nvm use --silent default >/dev/null 2>&1 || nvm use --silent 22 >/dev/null 2>&1 || true
    fi

    if [ -n "${NVM_BIN:-}" ] && [ -d "$NVM_BIN" ]; then
        path_prepend_distinct "$NVM_BIN"
        hash -r 2>/dev/null || true
    fi
fi

# Prefer Zed as editor when its CLI is installed.
if command -v zed >/dev/null 2>&1; then
    export EDITOR="zed --wait"
    export VISUAL="$EDITOR"
fi

# Activate an existing project venv or create a local .venv in the target dir.
venv() {
    local project_dir="${1:-.}"
    local activate_path=""
    local py=""
    local candidates=(
        "$project_dir/.venv/bin/activate"
        "$project_dir/venv/bin/activate"
        "$project_dir/env/bin/activate"
        "$project_dir/.venv/Scripts/activate"
        "$project_dir/venv/Scripts/activate"
        "$project_dir/env/Scripts/activate"
    )

    if [ ! -d "$project_dir" ]; then
        echo "Error: Directory '$project_dir' not found."
        return 1
    fi

    for activate_path in "${candidates[@]}"; do
        if [ -f "$activate_path" ]; then
            echo "Activating: $activate_path"
            # shellcheck disable=SC1090
            source "$activate_path" || return 1
            echo "Python: $(python -V) @ $(python -c 'import sys; print(sys.prefix)')"
            return 0
        fi
    done

    for py in python3 python; do
        if command -v "$py" >/dev/null 2>&1; then
            echo "No venv found in '$project_dir'. Creating .venv ..."
            "$py" -m venv "$project_dir/.venv" || {
                echo "venv creation failed"
                return 1
            }
            activate_path="$project_dir/.venv/bin/activate"
            echo "Activating: $activate_path"
            # shellcheck disable=SC1090
            source "$activate_path" || return 1
            echo "Python: $(python -V) @ $(python -c 'import sys; print(sys.prefix)')"
            if [ -f "$project_dir/requirements.txt" ]; then
                echo "requirements.txt detected. Install dependencies manually when ready:"
                echo "  pip install -r \"$project_dir/requirements.txt\""
            fi
            return 0
        fi
    done

    echo "Error: No python interpreter found."
    return 1
}
