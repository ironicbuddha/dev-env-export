{
  "theme": "One Dark",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "agent_font_size": 15,
  "format_on_save": "on",
  "formatter": "language_server",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "soft_wrap": "preferred_line_length",
  "preferred_line_length": 100,
  "relative_line_numbers": true,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "inlay_hints": {
    "enabled": true
  },
  "features": {
    "edit_prediction_provider": "none"
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 80,
      "format_on_save": "off"
    },
    "Python": {
      "preferred_line_length": 88
    },
    "JSON": {
      "tab_size": 2
    },
    "JSONC": {
      "tab_size": 2
    },
    "TypeScript": {
      "preferred_line_length": 100
    },
    "TSX": {
      "preferred_line_length": 100
    },
    "JavaScript": {
      "preferred_line_length": 100
    },
    "JSX": {
      "preferred_line_length": 100
    }
  }
}
