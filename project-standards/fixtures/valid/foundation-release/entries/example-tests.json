{
  "$schema": "https://schemas.ironicbuddha.dev/project-standards/v1/catalogue-entry.schema.json",
  "schemaVersion": "1.0.0",
  "id": "entry/capability/example-tests",
  "family": "capability",
  "kind": "example-tests",
  "version": "1.0.0",
  "scopeKinds": ["workload"],
  "cardinality": "multiple",
  "authorityClasses": [
    {
      "id": "authority/project-policy",
      "description": "May accept project-policy risk for the exact governed decision.",
      "resolution": "named-identity"
    }
  ],
  "choices": [],
  "rules": [
    {
      "id": "rule/example-tests/direct-tests",
      "statement": "Critical paths have direct behavioral tests.",
      "applicability": {
        "kind": "entry-selected",
        "entryId": "entry/workload/example-service"
      },
      "requirementIds": [
        "requirement/example-tests/test-command-gate",
        "requirement/example-tests/direct-tests-review",
        "requirement/example-tests/manual-assurance",
        "requirement/example-tests/direct-tests"
      ],
      "waiverPolicy": {
        "kind": "governed",
        "reasonClasses": ["temporary-tooling-gap"],
        "authorityClass": "authority/project-policy",
        "independence": "not-author",
        "maximumDurationDays": 14,
        "compensatingControlRequirementIds": [
          "requirement/example-tests/test-command-gate"
        ],
        "renewalConditions": {
          "freshEvidence": true,
          "freshApproval": true
        }
      }
    }
  ],
  "artifacts": [
    {
      "id": "artifact/example-tests/test-command",
      "locatorTemplate": "{workload.root}/package.json#scripts.test",
      "ownership": "structured-fragment",
      "compositionContract": "composition/package-json"
    }
  ],
  "checks": [
    {
      "id": "check/example-tests/test-command",
      "executable": "pnpm",
      "arguments": ["test"],
      "scope": { "kind": "owning-layer" },
      "prerequisiteCheckIds": [],
      "toolchain": { "name": "pnpm", "version": "11.22.0" },
      "timeoutMs": 120000,
      "network": "forbidden",
      "secrets": "forbidden",
      "retryPolicy": { "maximumAttempts": 1, "retryableResults": [] },
      "passCriteria": "exit-zero"
    }
  ],
  "requirements": [
    {
      "id": "requirement/example-tests/test-command-gate",
      "ruleId": "rule/example-tests/direct-tests",
      "phase": "baseline",
      "kind": "deterministic-check",
      "checkId": "check/example-tests/test-command",
      "independence": "none",
      "freshness": { "kind": "until-input-change" }
    },
    {
      "id": "requirement/example-tests/direct-tests-review",
      "ruleId": "rule/example-tests/direct-tests",
      "phase": "baseline",
      "kind": "attributable-review",
      "authorityClass": "authority/project-policy",
      "independence": "not-author",
      "freshness": { "kind": "maximum-age", "maximumAgeSeconds": 86400 },
      "questions": [
        {
          "id": "question/example-tests/direct-tests",
          "prompt": "Do the declared tests directly exercise every critical path in scope?"
        }
      ]
    },
    {
      "id": "requirement/example-tests/manual-assurance",
      "ruleId": "rule/example-tests/direct-tests",
      "phase": "baseline",
      "kind": "manual-state",
      "authorityClass": "authority/project-policy",
      "independence": "none",
      "freshness": { "kind": "maximum-age", "maximumAgeSeconds": 86400 },
      "manualState": {
        "target": "services/api test gate",
        "observableState": "The required test gate is enabled for the selected Workload.",
        "instructions": ["Inspect and record the exact test-gate state."],
        "assurance": "machine-readback",
        "checkId": "check/example-tests/test-command"
      }
    },
    {
      "id": "requirement/example-tests/direct-tests",
      "ruleId": "rule/example-tests/direct-tests",
      "phase": "delivery",
      "kind": "deterministic-check",
      "checkId": "check/example-tests/test-command",
      "independence": "none",
      "freshness": { "kind": "until-input-change" },
      "baselineGateRequirementId": "requirement/example-tests/test-command-gate"
    }
  ],
  "requires": [
    {
      "entryId": "entry/workload/example-service",
      "scopeRelation": "same-workload"
    }
  ],
  "refines": [
    {
      "ruleId": "rule/example-tests/direct-tests",
      "refinesRuleId": "rule/core/exact-catalogue-pin",
      "scopeRelation": "repository"
    }
  ],
  "incompatibleWith": [],
  "nestedRootContracts": [],
  "sourceGuidanceIds": ["guidance/foundation"],
  "supportEvidenceIds": ["support/foundation"],
  "fixtureIds": ["fixture/configuration/valid-foundation"],
  "migrationIds": [],
  "extensions": {}
}
