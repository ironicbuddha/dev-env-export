{
  "$schema": "https://schemas.ironicbuddha.dev/project-standards/v1/catalogue-entry.schema.json",
  "schemaVersion": "1.0.0",
  "id": "entry/capability/example-conflict",
  "family": "capability",
  "kind": "example-conflict",
  "version": "1.0.0",
  "scopeKinds": ["workload"],
  "cardinality": "singleton",
  "authorityClasses": [],
  "choices": [],
  "rules": [
    {
      "id": "rule/example-conflict/alternate-test-gate",
      "statement": "The alternate test gate is installed.",
      "applicability": { "kind": "always" },
      "requirementIds": [
        "requirement/example-conflict/alternate-test-gate"
      ],
      "waiverPolicy": { "kind": "prohibited" }
    }
  ],
  "artifacts": [
    {
      "id": "artifact/example-conflict/alternate-test-gate",
      "locatorTemplate": "{workload.root}/alternate-test-gate.json",
      "ownership": "whole-file"
    }
  ],
  "checks": [
    {
      "id": "check/example-conflict/alternate-test-gate",
      "executable": "alternate-test-gate",
