      "timeoutMs": 120000,
      "network": "forbidden",
      "secrets": "forbidden",
      "retryPolicy": { "maximumAttempts": 1, "retryableResults": [] },
      "passCriteria": "exit-zero"
    }
  ],
  "requirements": [
    {
      "id": "requirement/example-conflict/alternate-test-gate",
      "ruleId": "rule/example-conflict/alternate-test-gate",
      "phase": "baseline",
      "kind": "deterministic-check",
      "checkId": "check/example-conflict/alternate-test-gate",
      "independence": "none"
    }
  ],
  "requires": [
    {
      "entryId": "entry/workload/example-service",
      "scopeRelation": "same-workload"
    }
  ],
  "refines": [],
  "incompatibleWith": [
