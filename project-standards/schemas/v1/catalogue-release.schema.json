{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ironicbuddha.dev/project-standards/v1/catalogue-release.schema.json",
  "title": "Catalogue Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogueVersion",
    "catalogueDigest",
    "schemas",
    "entries",
    "migrations",
    "fixtures",
    "sourceGuidance",
    "supportEvidence",
    "extensions"
  ],
  "properties": {
    "$schema": { "const": "https://schemas.ironicbuddha.dev/project-standards/v1/catalogue-release.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "catalogueVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalogueDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://schemas\\.ironicbuddha\\.dev/project-standards/v1/[a-z][a-z-]*\\.schema\\.json$"
      }
    },
    "entries": {
      "type": "array",
      "items": { "type": "string", "pattern": "^entries/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    },
    "migrations": {
      "type": "array",
      "items": { "type": "string", "pattern": "^migrations/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    },
    "fixtures": {
      "type": "array",
      "items": { "type": "string", "pattern": "^fixtures/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    },
    "sourceGuidance": {
      "type": "array",
      "items": { "type": "string", "pattern": "^source-guidance/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    },
    "supportEvidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^support-evidence/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^extensions/[a-z0-9][a-z0-9./-]*\\.json$" },
      "uniqueItems": true
    }
  }
}
