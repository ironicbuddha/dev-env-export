{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ironicbuddha.dev/project-standards/v1/fixture.schema.json",
  "title": "Catalogue Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "subject", "expectation", "document"],
  "properties": {
    "$schema": { "const": "https://schemas.ironicbuddha.dev/project-standards/v1/fixture.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^fixture/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" },
    "subject": { "enum": ["configuration", "catalogue-release", "catalogue-entry", "migration", "extension", "verification"] },
    "expectation": { "enum": ["valid", "invalid", "verified", "incomplete"] },
    "document": { "type": "object" },
    "expectedErrorCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
  },
  "allOf": [
    {
      "if": { "properties": { "expectation": { "const": "invalid" } } },
      "then": {
        "required": ["expectedErrorCodes"],
        "properties": {
          "expectedErrorCodes": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["subject"],
        "properties": { "subject": { "const": "verification" } }
      },
      "then": {
        "properties": {
          "expectation": { "enum": ["verified", "incomplete"] },
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding", "suppression", "repetitions"],
            "properties": {
              "binding": { "enum": ["exact", "missing"] },
              "suppression": { "enum": ["matching", "drifted"] },
              "repetitions": { "type": "integer", "minimum": 1, "maximum": 2 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectation": { "enum": ["valid", "invalid"] }
        }
      }
    }
  ]
}
