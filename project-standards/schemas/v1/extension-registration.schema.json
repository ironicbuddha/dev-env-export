{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ironicbuddha.dev/project-standards/v1/extension-registration.schema.json",
  "title": "Extension Registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "namespace", "targets", "schema"],
  "properties": {
    "$schema": { "const": "https://schemas.ironicbuddha.dev/project-standards/v1/extension-registration.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^extension/[a-z][a-z0-9-]*$" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["configuration", "manifest", "waiver", "evidence", "catalogue-entry"] } },
    "schema": {
      "type": "object",
      "required": ["$schema", "$id", "type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "$id": { "type": "string", "format": "uri" },
        "type": {}
      }
    }
  }
}
