{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ironicbuddha.dev/project-standards/v1/configuration.schema.json",
  "title": "Bootstrap Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogueVersion",
    "catalogueDigest",
    "core",
    "workloads",
    "capabilities",
    "extensions"
  ],
  "properties": {
    "$schema": { "const": "https://schemas.ironicbuddha.dev/project-standards/v1/configuration.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "catalogueVersion": { "$ref": "#/$defs/version" },
    "catalogueDigest": { "$ref": "#/$defs/digest" },
    "core": { "$ref": "#/$defs/core" },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workload" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "instanceId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "choices": {
      "type": "object",
      "propertyNames": { "pattern": "^choice/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "boolean" },
          { "type": "integer" }
        ]
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
      "additionalProperties": true
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "choices"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "choices": { "$ref": "#/$defs/choices" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "root", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/instanceId" },
        "kind": { "$ref": "#/$defs/kind" },
        "root": {
          "type": "string",
          "pattern": "^(?:\\.|[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*)$"
        },
        "choices": { "$ref": "#/$defs/choices" }
      }
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "repository" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workloadIds"],
          "properties": {
            "kind": { "const": "workload" },
            "workloadIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/instanceId" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workloadIds"],
          "properties": {
            "kind": { "const": "cross-workload" },
            "workloadIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/instanceId" }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/instanceId" },
        "kind": { "$ref": "#/$defs/kind" },
        "scope": { "$ref": "#/$defs/scope" },
        "choices": { "$ref": "#/$defs/choices" }
      }
    }
  }
}
