{
  "name": "@ironicbuddha/project-standards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "project-standards-catalogue": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:catalogue": "tsc -p tsconfig.json && node --test dist/test/catalogue-release.test.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "typescript": "5.9.3"
  }
}
